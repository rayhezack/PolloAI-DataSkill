{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L2 metric",
  "type": "object",
  "required": ["id", "name", "table", "type", "expr", "filters", "unit", "status", "owner"],
  "properties": {
    "id": {"type": "string", "pattern": "^M-(PAY|CRE|USR|AD|AGT)-[0-9]{3}$"},
    "name": {"type": "string"},
    "synonyms": {"type": "array", "items": {"type": "string"}},
    "definition": {"type": "string"},
    "table": {"type": "string", "pattern": "^T-[0-9]{3}$|^TBD$"},
    "type": {"enum": ["atomic", "ratio", "derived"]},
    "expr": {"type": "string"},
    "numerator": {"type": "string", "pattern": "^M-"},
    "denominator": {"type": "string"},
    "filters": {"type": "array", "items": {"type": "string"}},
    "dedup_key": {"type": "string"},
    "time_axis": {"type": "string"},
    "unit": {"type": "string"},
    "aggregation": {"enum": ["total", "per_day", "rate", "snapshot"]},
    "dimensions": {"type": "array", "items": {"type": "string", "pattern": "^D-[0-9]{3}$"}},
    "traps": {"type": "array", "items": {"type": "string", "pattern": "^P-[0-9]{2}$"}},
    "open_question": {"type": "string", "pattern": "^OQ-[0-9]{2}$"},
    "disclaimer": {"type": "string"},
    "status": {"$ref": "common#/status"},
    "owner": {"type": "string"},
    "reviewed_by": {"type": "string"},
    "reviewed_at": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "superseded_by": {"type": "string"}
  },
  "additionalProperties": false
}

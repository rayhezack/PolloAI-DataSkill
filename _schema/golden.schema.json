{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "status", "created_at", "owner", "purpose", "evaluation_boundary", "reference_policy", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["draft", "pending_review", "pilot", "verified"]},
    "created_at": {"type": "string"},
    "owner": {"type": "string"},
    "purpose": {"type": "string"},
    "evaluation_boundary": {"type": "string"},
    "reference_policy": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "additionalProperties": false,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reference": {
      "type": "object",
      "required": ["file", "match", "values", "absolute_tolerance"],
      "properties": {
        "file": {"type": "string"},
        "match": {"type": "object", "minProperties": 1},
        "values": {"type": "object", "minProperties": 1},
        "absolute_tolerance": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["id", "domain", "status", "question", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^GQ-[0-9]{3}$"},
        "domain": {"enum": ["USR", "PAY", "CRE", "AD", "AGT"]},
        "status": {"enum": ["draft", "pending_review", "pilot", "verified"]},
        "question": {"type": "string", "minLength": 1},
        "expected": {
          "type": "object",
          "required": ["behavior", "metrics", "tables", "checks"],
          "properties": {
            "behavior": {"enum": ["answer", "plan", "clarify", "explain_removed", "explain_unavailable", "explain_out_of_scope"]},
            "metrics": {"$ref": "#/$defs/strings"},
            "tables": {"$ref": "#/$defs/strings"},
            "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "query": {"type": "string", "pattern": "^K-[0-9]{3}$"},
            "parameters": {"type": "object", "additionalProperties": {"type": "string"}},
            "avoid": {"$ref": "#/$defs/strings"}
          },
          "additionalProperties": false
        },
        "reference": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}}]},
        "decision_sources": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    }
  }
}
